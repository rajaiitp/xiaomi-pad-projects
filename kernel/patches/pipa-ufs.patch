+		return;
+	}
 	if (--group->active_reqs)
 		return;
 	group->state = PM_QOS_REQ_UNVOTE;
@@ -1678,16 +1684,13 @@ static void ufs_qcom_pm_qos_req_end(struct ufs_hba *hba, struct request *req,
